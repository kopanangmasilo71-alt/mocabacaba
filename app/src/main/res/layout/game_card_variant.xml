<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_card_mini"
    android:clickable="true"
    android:focusable="true"
    android:padding="12dp">


    <!-- 2. Main Icon -->
    <ImageView
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:scaleType="fitCenter"
        android:src="@drawable/morabaraba_board"
        app:layout_constraintBottom_toTopOf="@id/rating_variant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 3. Rating -->
    <RatingBar
        android:id="@+id/rating_variant"
        style="?android:attr/ratingBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:isIndicator="true"
        android:layout_marginBottom="8dp"
        android:progressTint="@color/secondary_variant"
        android:rating="4.5"
        app:layout_constraintBottom_toTopOf="@id/action_variant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 4. Action Button (Improved Material Look) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/action_variant"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_marginHorizontal="2dp"
        android:background="@drawable/button_background_arcade"
        android:text="@string/label_play"
        android:textColor="@android:color/white"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:padding="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:backgroundTint="@null"
        app:cornerRadius="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/btn_info_variant"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/baseline_info_24"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:tint="#B0B0B0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
