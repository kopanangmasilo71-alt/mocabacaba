<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="visible">

    <com.masilo.morabarabacollection.SpiderPanel
        android:id="@+id/game_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Tactical HUD Header -->
    <LinearLayout
        android:id="@+id/hud_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/exit_button"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/status_update"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.05"
            android:text="READY"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/allocating_cows"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NO COWS"
            android:textColor="@color/secondary_variant"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Control Cluster -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/exit_button"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="110dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="60dp"
        android:background="@drawable/button_background_rabbit"
        android:text="@string/exit"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:icon="@drawable/baseline_logout_24"
        app:iconGravity="textStart"
        app:iconSize="18dp"
        app:iconTint="@color/accent_red"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/exit_button">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pause_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="110dp"
            android:layout_height="48dp"
            android:background="@drawable/button_background_rabbit"
            android:text="@string/pause"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:icon="@drawable/baseline_pause_circle_outline_24"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconTint="@color/secondary_variant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/resume_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="110dp"
            android:layout_height="48dp"
            android:background="@drawable/button_background_rabbit"
            android:text="@string/resume"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@null"
            app:icon="@drawable/baseline_stars_24"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconTint="@color/secondary_variant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/surrender_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="110dp"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_background_rabbit"
            android:text="@string/restart"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:icon="@drawable/baseline_restart_alt_24"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconTint="@color/secondary_variant" />

    </LinearLayout>

    <!-- Side Scoring Panel -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hud_header">

        <TextView
            android:id="@+id/black_goals"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BLACK"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/goal_b"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/draw"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/white_goals"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="WHITE"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/goal_w"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/draw"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
