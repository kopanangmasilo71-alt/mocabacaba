<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="@string/about_title"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- App Icon Placeholder or Logo -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <!-- Main Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/about_game_description"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <!-- Mission Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/mission_title"
            android:textColor="@color/secondary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/mission_body"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <!-- Key Features Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/key_features"
            android:textColor="@color/secondary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:drawableStart="@drawable/baseline_star_24"
                android:drawablePadding="12dp"
                android:text="@string/feature_single_player"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:drawableTint="@color/secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:drawableStart="@drawable/baseline_star_24"
                android:drawablePadding="12dp"
                android:text="@string/feature_multiplayer"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:drawableTint="@color/secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:drawableStart="@drawable/baseline_star_24"
                android:drawablePadding="12dp"
                android:text="@string/feature_difficulty"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:drawableTint="@color/secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:drawableStart="@drawable/baseline_star_24"
                android:drawablePadding="12dp"
                android:text="@string/feature_variations"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:drawableTint="@color/secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:drawableStart="@drawable/baseline_star_24"
                android:drawablePadding="12dp"
                android:text="@string/feature_visuals"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:drawableTint="@color/secondary" />
        </LinearLayout>

        <!-- Development Team -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/development_team_title"
            android:textColor="@color/secondary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/development_team"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <!-- Credits Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/credits_title"
            android:textColor="@color/secondary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/credits_body"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <!-- Privacy Policy Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/privacy_policy"
            android:textColor="@color/secondary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:autoLink="web"
            android:linksClickable="true"
            android:text="@string/privacy_policy_link"
            android:textColor="@color/white"
            android:textColorLink="@color/secondary"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/read_full_policy_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/read_full_policy"
            android:textColor="@color/secondary"
            android:textSize="14sp" />

        <!-- Footer Section -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="16dp"
            android:background="@color/white"
            android:alpha="0.3" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/version_info"
            android:textColor="@color/text_secondary_dark"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/contact_info"
            android:textColor="@color/text_secondary_dark"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="@string/legal_info"
            android:textColor="@color/text_secondary_dark"
            android:textSize="12sp"
            android:textStyle="italic" />

        <!-- Close Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/close_button"
            style="@style/AppButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:layout_marginBottom="16dp"
            android:text="@string/close"
            app:cornerRadius="24dp"
            app:drawableStartCompat="@drawable/baseline_close_24" />

    </LinearLayout>
</ScrollView>
