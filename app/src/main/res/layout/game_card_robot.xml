<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_drawable"
    android:padding="13dp">

    <!-- Faded Watermark Icon -->
    <ImageView
        android:layout_width="100dp"
        android:layout_height="95dp"
        android:alpha="0.15"
        android:contentDescription="@string/background"
        android:rotation="-15"
        android:scaleType="fitCenter"
        android:src="@drawable/robot_play"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:tint="@android:color/white" />

    <!-- Info Icon -->
    <ImageView
        android:id="@+id/btn_info_robot"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:src="@drawable/baseline_info_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#D0D0D0" />

    <!-- Title -->
    <TextView
        android:id="@+id/title_robot"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text="Robot Match"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btn_info_robot"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Main Icon -->
    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="47dp"
        android:layout_height="29dp"
        android:scaleType="fitCenter"
        android:src="@drawable/five1"
        app:layout_constraintBottom_toTopOf="@+id/rating_robot"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/desc_robot" />

    <!-- Description -->

    <!-- Rating -->
    <com.masilo.morabarabacollection.RainbowTextView
        android:id="@+id/desc_robot"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:text="@string/train_your_skills_against_our_smart_ai"
        android:textColor="#E0E0E0"
        android:textSize="13sp"
        app:layout_constraintBottom_toTopOf="@+id/rating_robot"
        app:layout_constraintEnd_toStartOf="@+id/btn_info_robot"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/imageView4"
        app:layout_constraintTop_toBottomOf="@id/title_robot"
        app:layout_constraintVertical_bias="0.233" />

    <RatingBar
        android:id="@+id/rating_robot"
        style="?android:attr/ratingBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:isIndicator="true"
        android:numStars="6"
        android:progressTint="@color/accent_green"
        android:rating="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Action Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/robot"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:background="@drawable/button_background_main"
        android:minWidth="100dp"
        android:paddingHorizontal="16dp"
        android:text="PLAY NOW"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
