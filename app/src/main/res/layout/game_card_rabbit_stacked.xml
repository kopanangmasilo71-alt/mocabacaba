<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_card_mini"
    android:clickable="true"
    android:focusable="true"
    android:padding="12dp">

    <!-- 1. Watermark Background Icon -->
    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/rabbit"
        android:alpha="0.1"
        android:rotation="-20"
        android:scaleType="fitCenter"
        app:tint="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 2. Main Icon -->
    <ImageView
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:scaleType="fitCenter"
        android:src="@drawable/haraaa"
        app:layout_constraintBottom_toTopOf="@id/rating_rabbit_stacked"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 3. Rating -->
    <RatingBar
        android:id="@+id/rating_rabbit_stacked"
        style="?android:attr/ratingBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:isIndicator="true"
        android:layout_marginBottom="12dp"
        android:progressTint="@color/secondary_variant"
        android:rating="5.0"
        app:layout_constraintBottom_toTopOf="@id/action_rabbit_stacked"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 4. Action Button (Improved Material Look) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/action_rabbit_stacked"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginHorizontal="4dp"
        android:background="@drawable/button_background_main"
        android:text="@string/label_play"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:padding="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:backgroundTint="@null"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 5. Title & Info Icon -->
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:text="@string/x2"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:letterSpacing="0.05"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_info_rabbit_stacked"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/btn_info_rabbit_stacked"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/baseline_info_24"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:tint="#B0B0B0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
